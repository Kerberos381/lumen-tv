<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumen helper. Scope is intentionally narrow:
  - window-state events: which app is in front (for Recents and the Home redirect)
  - key events: only to notice the Home button (snapshot + double-press)
  - screenshots: one small snapshot of the app you leave, kept on the TV
  It does NOT read text or controls inside other apps (canRetrieveWindowContent=false).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/helper_description"
    android:notificationTimeout="50" />
